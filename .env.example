# Copy to .env next to compose.yaml. Secrets go into ./secrets, not here.

# Public URL and WebAuthn relying party (the host name without scheme).
FA_PUBLIC_ORIGIN=https://finanzen.rxf-sys.de
FA_WEBAUTHN_RP_ID=finanzen.rxf-sys.de

# Cloudflare Zero Trust: team domain and the Application Audience (AUD) tag of the Access app.
FA_CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
FA_CF_ACCESS_AUD=

# Token of the Cloudflare Tunnel (Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=

# Image tag to deploy (git SHA or "latest").
APP_VERSION=latest

# Backups: restic repository (local path inside the container, or sftp:/s3: URL)
# and the host directory mounted at /backups.
RESTIC_REPOSITORY=/backups/restic
BACKUP_DIR=./backups
BACKUP_SCHEDULE=30 2 * * *
